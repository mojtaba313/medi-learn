generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum CourseStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id             String             @id @default(cuid())
  name           String
  username       String             @unique
  passwordHash   String
  role           Role               @default(STUDENT)
  createdAt      DateTime           @default(now())
  annotations    Annotation[]
  responses      QuestionResponse[]
  attempts       QuizAttempt[]
  sampleAttempts SampleAttempt[]
  courses        Course[]
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String
  category    String
  coverUrl    String?
  pdfUrl      String?
  status      CourseStatus  @default(PROCESSING)
  error       String?
  totalPages  Int           @default(0)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pages       Page[]
  questions   Question[]
  annotations Annotation[]
  attempts    QuizAttempt[]
  sampleSets  SampleSet[]
}

model Page {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber  Int
  imageUrl    String
  width       Int
  height      Int
  createdAt   DateTime     @default(now())
  annotations Annotation[]
  questions   Question[]

  @@unique([courseId, pageNumber])
  @@index([courseId])
}

model Annotation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber Int
  page       Page     @relation(fields: [courseId, pageNumber], references: [courseId, pageNumber], onDelete: Cascade)
  data       Json
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId, pageNumber])
  @@index([userId, courseId])
}

model Question {
  id            String             @id @default(cuid())
  courseId      String
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber    Int?
  page          Page?              @relation(fields: [courseId, pageNumber], references: [courseId, pageNumber], onDelete: SetNull)
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?
  tags          String[]
  createdAt     DateTime           @default(now())
  responses     QuestionResponse[]

  @@index([courseId, pageNumber])
}

model QuestionResponse {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  isCorrect      Boolean?
  timeSpentMs    Int      @default(0)
  answeredAt     DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mode      String
  score     Int
  total     Int
  correct   Int
  incorrect Int
  skipped   Int
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId, courseId])
}

enum SampleAttemptMode {
  EXAM
  PRACTICE
}

model SampleSet {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  timeLimitMinutes Int?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  questions        SampleQuestion[]
  attempts         SampleAttempt[]

  @@index([courseId])
}

model SampleQuestion {
  id              String           @id @default(cuid())
  sampleSetId     String
  sampleSet       SampleSet        @relation(fields: [sampleSetId], references: [id], onDelete: Cascade)
  text            String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String
  explanation     String?
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  sampleResponses SampleResponse[]

  @@index([sampleSetId])
}

model SampleAttempt {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sampleSetId     String
  sampleSet       SampleSet         @relation(fields: [sampleSetId], references: [id], onDelete: Cascade)
  mode            SampleAttemptMode @default(PRACTICE)
  score           Int?
  total           Int?
  correct         Int?
  incorrect       Int?
  unanswered      Int?
  durationMs      Int?
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  sampleResponses SampleResponse[]

  @@index([userId])
  @@index([sampleSetId])
}

model SampleResponse {
  id               String         @id @default(cuid())
  attemptId        String
  attempt          SampleAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sampleQuestionId String
  sampleQuestion   SampleQuestion @relation(fields: [sampleQuestionId], references: [id], onDelete: Cascade)
  selectedOption   String?
  isCorrect        Boolean?
  timeSpentMs      Int            @default(0)

  @@index([attemptId])
  @@index([sampleQuestionId])
}
