generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum CourseStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  username                String                   @unique
  passwordHash            String
  role                    Role                     @default(STUDENT)
  createdAt               DateTime                 @default(now())
  responses               QuestionResponse[]
  attempts                QuizAttempt[]
  sampleAttempts          SampleAttempt[]
  courses                 Course[]
  preferences             UserPreference?
  noteProgress            NoteProgress[]
  noteNotes               NoteNote[]
  textAnnotations         TextAnnotation[]
  noteAssetAnnotations    NoteAssetAnnotation[]
  annotations             Annotation[]
  createdNotes            Note[]
  bookmarks               Bookmark[]
  noteQuestionResponses   NoteQuestionResponse[]
  noteQuizAttempts        NoteQuizAttempt[]
  flashcardReviews        FlashcardReview[]
  studySessions           StudySession[]
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String
  category    String
  coverUrl    String?
  pdfUrl      String?
  status      CourseStatus  @default(PROCESSING)
  error       String?
  totalPages  Int           @default(0)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pages       Page[]
  questions   Question[]
  annotations Annotation[]
  attempts    QuizAttempt[]
  sampleSets  SampleSet[]
}

model Page {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber  Int
  imageUrl    String
  width       Int
  height      Int
  createdAt   DateTime     @default(now())
  annotations Annotation[]
  questions   Question[]

  @@unique([courseId, pageNumber])
  @@index([courseId])
}

model Annotation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber Int
  page       Page     @relation(fields: [courseId, pageNumber], references: [courseId, pageNumber], onDelete: Cascade)
  data       Json
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId, pageNumber])
  @@index([userId, courseId])
}

model Question {
  id            String             @id @default(cuid())
  courseId      String
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pageNumber    Int?
  page          Page?              @relation(fields: [courseId, pageNumber], references: [courseId, pageNumber], onDelete: SetNull)
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?
  tags          String[]
  createdAt     DateTime           @default(now())
  responses     QuestionResponse[]

  @@index([courseId, pageNumber])
}

model QuestionResponse {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  isCorrect      Boolean?
  timeSpentMs    Int      @default(0)
  answeredAt     DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mode      String
  score     Int
  total     Int
  correct   Int
  incorrect Int
  skipped   Int
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId, courseId])
}

enum SampleAttemptMode {
  EXAM
  PRACTICE
}

model SampleSet {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  timeLimitMinutes Int?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  questions        SampleQuestion[]
  attempts         SampleAttempt[]

  @@index([courseId])
}

model SampleQuestion {
  id              String           @id @default(cuid())
  sampleSetId     String
  sampleSet       SampleSet        @relation(fields: [sampleSetId], references: [id], onDelete: Cascade)
  text            String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String
  explanation     String?
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  sampleResponses SampleResponse[]

  @@index([sampleSetId])
}

model SampleAttempt {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sampleSetId     String
  sampleSet       SampleSet         @relation(fields: [sampleSetId], references: [id], onDelete: Cascade)
  mode            SampleAttemptMode @default(PRACTICE)
  score           Int?
  total           Int?
  correct         Int?
  incorrect       Int?
  unanswered      Int?
  durationMs      Int?
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  sampleResponses SampleResponse[]

  @@index([userId])
  @@index([sampleSetId])
}

model SampleResponse {
  id               String         @id @default(cuid())
  attemptId        String
  attempt          SampleAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sampleQuestionId String
  sampleQuestion   SampleQuestion @relation(fields: [sampleQuestionId], references: [id], onDelete: Cascade)
  selectedOption   String?
  isCorrect        Boolean?
  timeSpentMs      Int            @default(0)

  @@index([attemptId])
  @@index([sampleQuestionId])
}

model Note {
  id                String              @id @default(cuid())
  slug              String              @unique
  kind              String              @default("STRUCTURED")
  order             Int                 @default(0)
  number            Int                 @default(0)
  title             String
  cardTitle         String
  eyebrow           String?
  cardDescription   String?
  description       String
  pills             String[]            @default([])
  footer            String?
  gallery           Json?
  referencesTitle   String?
  referencesIntro   String?
  referencesHtml    String?
  quizTitle         String?
  quizDescription   String?
  quizNavLabel      String?
  blocks            Json?
  searchText        String              @default("")
  totalPages        Int                 @default(0)
  createdById       String?
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assets            NoteAsset[]
  questions         NoteQuestion[]
  flashcards        Flashcard[]
  quizAttempts      NoteQuizAttempt[]
  studySessions     StudySession[]
  progress          NoteProgress[]
  notes             NoteNote[]
  annotations       TextAnnotation[]
  bookmarks         Bookmark[]
  assetAnnotations  NoteAssetAnnotation[]

  @@index([order])
}

model NoteAsset {
  id         String            @id @default(cuid())
  noteId     String
  note       Note              @relation(fields: [noteId], references: [id], onDelete: Cascade)
  assetId    String
  kind       String            @default("IMAGE")
  fileName   String
  mimeType   String
  size       Int               @default(0)
  width      Int?
  height     Int?
  storageKey String
  annotations NoteAssetAnnotation[]

  @@unique([noteId, assetId])
  @@index([noteId])
}

model NoteAssetAnnotation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note              @relation(fields: [noteId], references: [id], onDelete: Cascade)
  assetId   String
  asset     NoteAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  blockId   String
  data      Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, assetId, blockId])
  @@index([userId, noteId])
}

model NoteQuestion {
  id            String                   @id
  noteId        String
  note          Note                     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteSlug      String?
  blockId       String?
  order         Int                      @default(0)
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String
  topic         String?
  createdAt     DateTime                 @default(now())
  responses     NoteQuestionResponse[]

  @@index([noteId, order])
}

model NoteQuestionResponse {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       NoteQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  isCorrect      Boolean?
  timeSpentMs    Int            @default(0)
  answeredAt     DateTime       @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model NoteQuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId           String
  note             Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  mode             String   @default("STUDY")
  score            Int
  total            Int
  correct          Int
  incorrect        Int
  skipped          Int
  answers          Json
  topicStats       Json?
  wrongQuestionIds String[] @default([])
  createdAt        DateTime @default(now())

  @@index([userId, noteId])
}

model Flashcard {
  id         String            @id
  noteId     String
  note       Note              @relation(fields: [noteId], references: [id], onDelete: Cascade)
  order      Int               @default(0)
  term       String
  definition String
  reviews    FlashcardReview[]

  @@index([noteId, order])
}

model FlashcardReview {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  interval  Int       @default(0)
  ease      Float     @default(2.5)
  reps      Int       @default(0)
  lapses    Int       @default(0)
  due       DateTime  @default(now())
  last      DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([userId, cardId])
  @@index([userId, due])
}

model NoteProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId       String
  note         Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  done         Boolean   @default(false)
  lastOpenedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, noteId])
  @@index([userId])
}

model NoteNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  text      String
  updatedAt DateTime @updatedAt

  @@unique([userId, noteId])
}

model TextAnnotation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  blockId     String?
  color       String
  content     String?
  quote       String
  startPath   Int[]
  startOffset Int
  endPath     Int[]
  endOffset   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, noteId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
}

model StudySession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?
  note      Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  courseId  String?
  minutes   Int
  kind      String    @default("focus")
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
}

model UserPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String   @default("dark")
  fontSize         String   @default("md")
  lineHeight       String   @default("normal")
  readingWidth     String   @default("normal")
  dailyGoalMinutes Int      @default(60)
  pomodoroFocus    Int      @default(25)
  pomodoroBreak    Int      @default(5)
  updatedAt        DateTime @updatedAt
}
